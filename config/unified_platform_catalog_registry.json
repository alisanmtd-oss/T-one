    "approved_render_modes": ["neutral_text_badge", "licensed_or_owner_supplied_image"],
    "current_render_mode": "neutral_text_badge",
    "current_asset_status": "not_supplied_or_approved",
    "rule": "只有负责人提供或书面批准、且来源与许可可追溯的品牌素材才能显示为官方 Logo；当前字母块只是中性文字缩写，不是官方 Logo。",
    "download_generate_or_repaint_without_approval": false
  },
  "categories": [
    {
      "id": "ecommerce_platform",
      "label": "电商平台",
      "description": "店铺、商品、订单、流量、广告、库存和结算；具体字段按平台规则源显示。"
    },
    {
      "id": "social_media",
      "label": "社交媒体",
      "description": "内容账号、主页、互动、评论、线索和获批发布；不等于电商店铺或订单来源。"
    },
    {
      "id": "b2b_platform",
      "label": "B2B平台",
      "description": "B2B 店铺、平台广告、询盘、报价和跟单；不与主动外联或货源采购混为一类。"
    },
    {
      "id": "sourcing_supply",
      "label": "货源与供应",
      "description": "供应商、货盘、询报价、样品、采购、质检和权利审核；不等于销售店铺。"
    }
  ],
