  "purpose": "Shared platform/site/store-mode/entity/tax-profile/campaign-version finance registry. It estimates budgets and inventory, but imported platform settlement statements remain canonical for actuals.",
  "truth_rules": {
    "pre_operation_estimates": "Estimates are planning drafts only and must never overwrite official settlement statements.",
    "actual_platform_settlement": "Imported settlement, bill, invoice and payout statement lines are canonical for actual results.",
    "unknown_rates": "Missing, stale, conflicting or unsupported rates remain unknown. Never infer a rate from a seller anecdote.",
    "campaign_version_gate": "Campaign-derived numbers require a dated, exact activity_rule_snapshot_id. Manual owner estimates remain drafts and are not platform rules.",
    "local_bank_boundary": "A local bank account does not change a tax rate unless an exact official rule explicitly says so.",
    "tax_ledger_boundary": "Buyer indirect tax, platform withholding, customs/import deductions and seller-entity taxes outside the platform are separate ledgers.",
    "sample_data": "Tests and formal-app demos may use fictional values only when marked sample_not_platform_rule.",
    "sample_finance_separation": "Creator samples are not advertising spend. Track sample product cost, outbound shipping, refundable-sample cash reserve, refund and platform-fee reversal separately.",
    "affiliate_commission_base": "A creator commission rate must use verified affiliate-attributed sales, not total store gross revenue. Missing attribution base remains unknown.",
    "platform_expert_rule_ownership": "Every platform expert owns dated rules by platform, site, store mode, seller/tax profile and exact activity snapshot. Shared finance logic must not invent platform-specific rates.",
    "external_action_boundary": "This registry never connects stores, files tax returns, changes campaigns, spends ads, pays, refunds, ships or sends messages."
  },
