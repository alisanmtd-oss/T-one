{
  "schema_version": "2026-07-25.g65-global-commerce-models",
  "updated_at": "2026-07-25T00:00:00+08:00",
  "registry_kind": "global_commerce_dimension_registry",
  "purpose": "统一登记 T One 的国家/站点、产品、履约、流量、内容、客户、财务和风险维度；供跨境电商、中国电商、社交媒体、外贸、POD、工厂、货源和 B2B 共同使用。",
  "truth_policy": {
    "no_fake_connection": true,
    "external_actions": 0,
    "unknown_until_evidenced": true,
    "dashboard_zero_means_no_local_or_authorized_data": true,
    "parent_sku_only_for_sku_count": true,
    "real_platform_bill_is_final_finance_truth": true
  },
  "commerce_model_taxonomy": {
    "composition_policy": {
      "relationship_model": "one_primary_model_plus_optional_secondary_models",
      "commerce_forms": "multiple_forms_allowed_per_project_store_or_product_line",
      "dashboard_usage": "filter_group_and_analyze_only; model existence never means platform data exists",
      "ai_routing_usage": "route by relationship_model + commerce_forms + platform + country_site + store_mode + product_family",
      "owner_review_required_for": ["b2g", "c2m", "s2b2c", "platform_self_operated", "online_auction_commerce"]
    },
    "relationship_models": [
      {
        "id": "b2b",
        "label": "B2B",
        "chinese_label": "企业对企业",
        "description": "企业向企业销售商品、原料、货盘、服务或解决方案。",
        "typical_dimensions": ["company_account", "inquiry", "quote", "contract", "sample", "credit_terms", "invoice", "fulfillment_batch"]
      },
      {
        "id": "b2c",
        "label": "B2C",
        "chinese_label": "企业对消费者",
        "description": "商家或品牌面向个人消费者销售。",
        "typical_dimensions": ["store", "listing", "order", "buyer", "payment", "review", "return", "customer_service"]
      },
      {
        "id": "c2c",
        "label": "C2C",
        "chinese_label": "消费者对消费者",
        "description": "个人卖家或用户之间交易，平台通常提供撮合、支付和信用体系。",
        "typical_dimensions": ["personal_seller", "buyer", "auction_or_offer", "message", "dispute", "platform_escrow"]
      },
      {
        "id": "d2c",
        "label": "D2C",
        "chinese_label": "品牌直达消费者",
        "description": "品牌、工厂或内容主体绕过传统中间商，直接面向消费者经营。",
        "typical_dimensions": ["brand_site", "owned_store", "crm", "subscription", "content_funnel", "repeat_purchase", "lifetime_value"]
      },
      {
        "id": "c2b",
        "label": "C2B",
        "chinese_label": "消费者反向定制/报价",
        "description": "消费者提出需求、价格或定制要求，企业按需求响应。",
        "typical_dimensions": ["custom_request", "target_budget", "demand_pool", "quote_response", "custom_order", "owner_review"]
      },
      {
        "id": "b2b2c",
        "label": "B2B2C",
        "chinese_label": "企业经渠道触达消费者",
        "description": "供应商、平台、服务商或渠道商协作，最终面向消费者完成交易。",
        "typical_dimensions": ["supplier", "channel_partner", "storefront", "consumer_order", "commission", "settlement_split"]
      },
      {
        "id": "b2g",
        "label": "B2G",
        "chinese_label": "企业对政府/公共机构",
        "description": "面向政府、学校、公共机构或大型组织的采购、招投标和履约。",
        "typical_dimensions": ["tender", "qualification", "compliance_document", "bid", "contract", "delivery_acceptance", "invoice"]
      },
      {
        "id": "o2o",
        "label": "O2O",
        "chinese_label": "线上到线下/线下到线上",
        "description": "线上获客、预约、支付或下单，线下体验、交付、核销或服务。",
        "typical_dimensions": ["online_channel", "offline_location", "appointment", "coupon", "qr_check", "pickup_or_service", "local_inventory"]
      },
      {
        "id": "c2m",
        "label": "C2M",
        "chinese_label": "消费者到制造",
        "description": "消费者需求、预售或数据直接驱动工厂设计、生产和备货。",
        "typical_dimensions": ["demand_signal", "preorder", "prototype", "moq", "production_plan", "lead_time", "factory_capacity"]
      },
      {
        "id": "s2b2c",
        "label": "S2B2C",
        "chinese_label": "供应链平台赋能商家触达消费者",
        "description": "供应链、货盘、仓配或 SaaS 平台服务小 B，由小 B 面向消费者销售。",
        "typical_dimensions": ["supply_platform", "small_business", "catalog", "dropship_or_resale", "service_fee", "consumer_order", "settlement_split"]
      }
    ],
    "commerce_forms": [
      {
        "id": "cross_border_commerce",
        "label": "跨境电商",
        "description": "跨国家/地区销售、履约、结算和合规的电商形态。",
        "typical_dimensions": ["country_site", "customs", "fx_rate", "vat_or_sales_tax", "cross_border_logistics", "localized_content"]
      },
      {
        "id": "social_commerce",
        "label": "社交电商",
        "description": "以社交关系、达人、社群、私域或互动为核心的交易形态。",
        "typical_dimensions": ["social_account", "creator", "community", "dm", "comment", "share", "affiliate", "trust_signal"]
      },
      {
        "id": "content_commerce",
        "label": "内容电商",
        "description": "通过短视频、直播、图文、测评、博客或种草内容驱动交易。",
        "typical_dimensions": ["content_asset", "view", "watch_time", "click", "product_card", "conversion", "creator_authorization"]
      },
      {
        "id": "subscription_commerce",
        "label": "订阅电商",
        "description": "按周期复购、会员订阅、补充装或服务计划产生收入。",
        "typical_dimensions": ["subscription_plan", "renewal", "churn", "cohort", "lifetime_value", "recurring_revenue"]
      },
      {
        "id": "platform_self_operated",
        "label": "平台自营",
        "description": "平台以自营或强控货品方式经营，商家可能是供应商、品牌方或供货方。",
        "typical_dimensions": ["vendor_account", "purchase_order", "platform_inventory", "retail_price", "vendor_terms", "chargeback", "settlement"]
      },
      {
        "id": "online_auction_commerce",
        "label": "线上拍卖电商",
        "description": "通过竞价、拍卖、限时出价或报价机制完成交易。",
        "typical_dimensions": ["auction_lot", "bid", "reserve_price", "winner", "escrow", "dispute", "auction_fee"]
      }
    ]
  },
