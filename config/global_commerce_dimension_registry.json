    "second_level": "group_by_platform_module_country_product_family",
    "store_level": "aggregate_by_platform_and_project; do_not_expand_all_stores_by_default",
    "product_level": "show_product_family_category_parent_sku_when_available; do_not_count_child_variants_as_parent_sku",
    "country_level": "show_country_site_group_and_count_when configured_or_imported",
