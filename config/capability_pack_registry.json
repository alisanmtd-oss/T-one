  "layer_note": "layers 仅表示能力包在安装界面的组合类型，不是岗位分类层级；岗位分类以 taxonomy_ref 为准。",
  "principles": [
    "能力按任务安装，不给所有用户加载全部岗位。",
    "店铺执行范围必须包含 platform + country/site + commerce mode + ownership + store_binding_id。",
    "安装能力包只配置本地任务能力，不代表第三方 API、账号或浏览器会话已经授权。",
    "一个浏览器环境/IP/窗口可以容纳多平台多店铺，但每次动作必须先选择唯一项目、平台、国家站点、模式、store_binding_id 与店铺级 execution_identity_id；凭据、数据、任务、审计证据和执行队列不得串店。",
    "official_full_managed 只保留为识别标签，TeeLab 不以平台官方全托管身份接入。"
  ],
  "scale_model": {
    "hierarchy": [
      "workspace",
      "project_group",
      "store_task",
