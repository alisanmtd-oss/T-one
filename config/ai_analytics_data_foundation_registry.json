  "product_selection_testing_contract": {
    "purpose": "让 AI 能追溯一个商品从候选来源、测试假设、测试投入、流量与转化，到履约退货、结算利润、放量或淘汰的完整因果链。",
    "lifecycle_stages": [
      "source_intake",
      "candidate_screen",
      "feasibility_review",
      "test_plan",
      "content_listing_test",
      "traffic_test",
      "paid_test_optional",
      "sales_validation",
      "fulfillment_return_validation",
      "unit_economics_reconciliation",
      "decision",
      "post_decision_review"
    ],
    "test_routes": [
      "direct_ship_before_stock",
      "small_batch_local_stock",
      "small_batch_overseas_stock",
      "organic_content_test",
      "paid_traffic_test_optional",
      "live_commerce_test",
      "creator_affiliate_test",
      "factory_virtual_prototype_draft_only",
      "pod_design_surface_variant_test"
    ],
    "decision_statuses": [
      "candidate_backlog",
      "researching",
      "ready_to_test",
      "testing",
      "insufficient_data",
      "scale",
      "retest",
      "hold",
      "exit",
      "rejected_risk",
      "blocked_missing_evidence"
    ],
    "required_test_plan_fields": [
      "product_candidate_id",
      "product_test_id",
      "platform",
      "country_site",
      "seller_mode",
      "test_route",
      "hypothesis",
      "start_at",
      "planned_end_at",
      "budget_ceiling",
      "stock_ceiling",
      "traffic_source",
      "content_or_listing_variants",
      "pass_thresholds",
      "fail_thresholds",
      "stop_loss_rules",
      "owner_gate_status"
    ],
    "required_decision_evidence": [
      "source_record_count",
      "test_duration_days",
      "traffic_and_conversion",
      "orders_and_sales_velocity",
      "refund_return_and_fulfillment",
      "actual_or_estimated_unit_economics",
      "inventory_and_cash_lockup",
      "threshold_result",
      "missing_fields",
      "decision_confidence",
      "decision_reason_codes"
    ],
    "threshold_policy": {
      "platform_and_category_specific": true,
      "sample_thresholds_are_not_platform_facts": true,
      "missing_threshold_is_unknown": true,
      "estimated_profit_cannot_override_actual_settlement": true,
      "scale_requires_owner_approval": true,
      "purchase_or_replenishment_requires_owner_approval": true,
      "real_publish_requires_platform_policy_and_owner_review": true
    },
    "failure_reason_taxonomy": [
      "insufficient_traffic",
      "low_click_through",
      "low_conversion",
      "price_mismatch",
      "creative_or_listing_mismatch",
      "poor_product_market_fit",
      "high_competition",
      "margin_below_floor",
      "high_ad_dependency",
      "high_return_or_refund",
      "quality_or_defect",
      "late_or_unreliable_fulfillment",
      "supplier_or_stock_risk",
      "cash_lockup_exceeds_limit",
      "compliance_or_ip_risk",
      "platform_policy_block",
      "seasonality_or_timing",
      "insufficient_evidence"
    ],
    "external_actions": 0
  },
  "operating_intelligence_contract": {
    "purpose": "把每一个可观察动作转成带身份、范围、前后状态、审批、回执和结果的数据事件；单店负责小方向，全局大盘负责跨平台、跨国家、跨产品和跨资源的大方向。",
    "hierarchy": [
      {"level": "atomic_action", "scope": "单次动作、输入、审批、执行、错误和结果"},
      {"level": "store_micro_direction", "scope": "单店的商品、流量、内容、广告、库存、客服、利润和风险建议"},
      {"level": "platform_site_rollup", "scope": "同平台、同国家站点下所有店铺聚合"},
      {"level": "product_country_rollup", "scope": "同产品族、品类、母体SKU和国家的跨店表现"},
      {"level": "business_group_direction", "scope": "事业组目标、预算、现金、人员、连接器和任务组合"},
      {"level": "group_macro_direction", "scope": "集团级资源配置、风险、项目组合、现金流和投资决策"}
    ],
    "every_action_event_requires": [
      "action_event_id",
      "occurred_at",
      "actor_type",
      "actor_id",
      "action_type",
      "action_scope",
      "target_object_type",
      "target_object_id",
      "project_id",
      "platform",
      "country_site",
      "store_id_or_not_applicable",
      "intent",
      "input_snapshot_hash",
      "before_state_hash",
      "permission_state",
      "approval_state",
      "execution_state",
      "external_side_effect",
      "output_or_error",
      "after_state_hash",
      "evidence_refs",
      "receipt_id",
      "trace_id"
    ],
    "forecast_requirements": [
      "forecast_id",
      "forecast_type",
      "scope",
      "generated_at",
      "forecast_horizon",
      "feature_window",
      "source_record_count",
      "feature_snapshot_hash",
      "model_id_and_version",
      "p10",
      "p50",
      "p90",
      "confidence",
      "missing_fields",
      "actual_when_available",
      "error_metrics_when_actual_available",
      "drift_status"
    ],
    "forecast_policy": {
      "precision_is_measured_not_claimed": true,
      "point_forecast_requires_interval": true,
      "actual_result_required_for_accuracy_score": true,
      "forecast_without_source_lineage_is_blocked": true,
      "low_sample_or_high_drift_must_reduce_confidence": true,
      "forecast_cannot_execute_action": true
    },
    "plan_adjustment_triggers": [
      "target_variance",
      "forecast_outside_plan_range",
      "cash_or_budget_limit",
      "inventory_shortage_or_overstock",
      "profit_below_floor",
      "traffic_or_conversion_anomaly",
      "return_or_quality_risk",
      "platform_or_compliance_change",
      "connector_or_data_quality_failure",
      "owner_strategy_change"
    ],
    "recommendation_lifecycle": [
      "detected",
      "evidence_attached",
      "drafted",
      "owner_review_required",
      "approved_or_modified_or_rejected",
      "executed_with_receipt_or_not_executed",
      "outcome_observed",
      "attribution_reviewed",
      "learning_memory_updated"
    ],
    "dashboard_direction_policy": {
      "store_view_is_micro_direction": true,
      "platform_site_view_is_rollup": true,
      "group_dashboard_is_macro_direction": true,
      "macro_recommendation_must_explain_store_and_platform_contributors": true,
      "store_recommendation_must_not_override_group_budget_or_risk_gate": true,
      "realtime_means_latest_local_or_authorized_data_not_unverified_external_live_data": true
    },
    "external_actions": 0
  },
  "business_action_metric_dictionary": {
    "purpose": "把当前系统实际记录的动作类型映射到业务对象和指标口径；未登记的新动作不得悄悄写入业务事件。",
    "required_runtime_event_types": [
      "task_created",
      "task_status_changed",
      "task_analysis_recorded",
      "task_result_recorded",
      "approval_requested",
      "approval_decision_recorded",
      "chat_object_enriched",
      "multimodal_intake_recorded",
      "learning_memory_approved",
      "organization_management_action",
      "agent_handoff_created",
      "agent_handoff_acknowledged",
      "operating_expense_recorded",
      "operating_expense_exported",
      "platform_finance_estimate_created",
      "inventory_cash_plan_created",
      "platform_statement_imported",
      "platform_settlement_reconciled",
      "payment_collection_estimate_created",
      "payment_collection_statement_imported",
      "payment_collection_reconciled",
      "forecast_created",
      "recommendation_created",
      "plan_adjusted",
      "connector_observation_recorded",
      "external_action_blocked"
    ],
    "contracts": [
      {
        "id": "task_lifecycle",
        "event_types": ["task_created", "task_status_changed"],
        "action_scope": "task",
        "target_object_type": "task_run",
        "metric_ids": ["action_event_count", "task_count", "state_change_count"],
        "truth_rule": "只表示本地任务状态；不得推断外部平台已执行。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "task_result",
        "event_types": ["task_analysis_recorded", "task_result_recorded"],
        "action_scope": "task",
        "target_object_type": "task_result_receipt",
        "metric_ids": ["action_event_count", "receipt_count", "receipt_coverage_rate"],
        "truth_rule": "分析是 inference；只有带回执的本地结果才是 fact，均不等于外部执行。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "approval_lifecycle",
        "event_types": ["approval_requested", "approval_decision_recorded"],
        "action_scope": "approval",
        "target_object_type": "approval_record",
        "metric_ids": ["action_event_count", "action_pending_approval_count", "owner_approval_count"],
        "truth_rule": "审批记录只证明决定或待审状态；外部动作仍需独立执行回执。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "chat_object_enrichment",
        "event_types": ["chat_object_enriched"],
        "action_scope": "conversation",
        "target_object_type": "business_object",
        "metric_ids": ["action_event_count", "source_record_count", "evidence_count"],
        "truth_rule": "聊天提取值必须保留来源与置信度；推断不得覆盖授权连接事实。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "multimodal_intake",
        "event_types": ["multimodal_intake_recorded"],
        "event_type_prefixes": ["multimodal_"],
        "action_scope": "source_intake",
        "target_object_type": "source_asset",
        "metric_ids": ["action_event_count", "source_record_count", "data_source_count"],
        "truth_rule": "保留原始附件引用、解析结果和推断层级；不把截图推断写成平台事实。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "learning_memory",
        "event_types": ["learning_memory_approved"],
        "action_scope": "learning_memory",
        "target_object_type": "reviewed_memory",
        "metric_ids": ["action_event_count", "action_learning_count", "evidence_count"],
        "truth_rule": "只有负责人核对来源后的经验记忆可记录；不得升级为官方平台规则或自动执行能力。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "organization_management",
        "event_types": ["organization_management_action"],
        "event_type_prefixes": ["organization_"],
        "action_scope": "organization",
        "target_object_type": "goal_or_assignment",
        "metric_ids": ["action_event_count", "plan_count", "handoff_count"],
        "truth_rule": "目标、优先级和分工是本地管理记录；人员身份和执行结果必须另有证据。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "agent_handoff",
        "event_types": ["agent_handoff_created", "agent_handoff_acknowledged"],
        "action_scope": "agent_handoff",
        "target_object_type": "agent_handoff",
        "metric_ids": ["action_event_count", "handoff_count", "receipt_count"],
        "truth_rule": "创建交接不等于接收或产出；确认和结果分别记录。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "operating_expense",
        "event_types": ["operating_expense_recorded", "operating_expense_exported"],
        "action_scope": "finance",
        "target_object_type": "operating_expense",
        "metric_ids": ["action_event_count", "operating_expense_amount", "source_record_count"],
        "truth_rule": "手工或导入费用必须标币种、日期、来源和 truth_level；不得当作平台结算。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "platform_finance_estimate",
        "event_types": ["platform_finance_estimate_created"],
        "action_scope": "platform_finance",
        "target_object_type": "finance_estimate",
        "metric_ids": ["action_event_count", "expected_profit", "expected_payout"],
        "truth_rule": "估算只用于预算和计划；未知费率保持 unknown，不能覆盖账单真值。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "platform_statement",
        "event_types": ["platform_statement_imported"],
        "action_scope": "platform_finance",
        "target_object_type": "platform_statement",
        "metric_ids": ["action_event_count", "settlement_amount", "source_record_count"],
        "truth_rule": "只有已导入的原始平台或支付渠道账单行可作为 actual_statement。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "inventory_cash_plan",
        "event_types": ["inventory_cash_plan_created"],
        "action_scope": "inventory_finance",
        "target_object_type": "inventory_cash_plan",
        "metric_ids": ["action_event_count", "replenishment_plan_count", "plan_count"],
        "truth_rule": "库存和资金计划是待审草稿；采购、补货和付款必须另行审批并留回执。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "settlement_reconciliation",
        "event_types": ["platform_settlement_reconciled"],
        "action_scope": "platform_finance",
        "target_object_type": "settlement_reconciliation",
        "metric_ids": ["action_event_count", "settlement_amount", "evidence_coverage_rate"],
        "truth_rule": "对账必须逐费用行关联估算、实际账单与差异原因。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "payment_collection",
        "event_types": ["payment_collection_estimate_created", "payment_collection_statement_imported", "payment_collection_reconciled"],
        "action_scope": "cash_collection",
        "target_object_type": "payment_collection_record",
        "metric_ids": ["action_event_count", "expected_payout", "settlement_amount"],
        "truth_rule": "估算、收款机构账单和银行实收分层保存；银行或支付渠道流水是相应现金层最终真值。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "forecast",
        "event_types": ["forecast_created"],
        "action_scope": "analytics",
        "target_object_type": "forecast",
        "metric_ids": ["action_event_count", "forecast_count", "forecast_confidence"],
        "truth_rule": "预测必须带来源窗口、样本数、区间和置信度；不能执行动作。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "recommendation",
        "event_types": ["recommendation_created"],
        "action_scope": "analytics",
        "target_object_type": "recommendation",
        "metric_ids": ["action_event_count", "recommendation_count", "recommendation_confidence"],
        "truth_rule": "建议必须引用数据缺口和证据；需要外部动作时进入负责人审批。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "plan_adjustment",
        "event_types": ["plan_adjusted"],
        "action_scope": "planning",
        "target_object_type": "plan_adjustment",
        "metric_ids": ["action_event_count", "plan_adjustment_count", "plan_variance_rate"],
        "truth_rule": "计划调整保留触发原因、前后值和审批状态。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "connector_observation",
        "event_types": ["connector_observation_recorded"],
        "event_type_prefixes": ["connector_"],
        "action_scope": "connector",
        "target_object_type": "connector_or_binding",
        "metric_ids": ["action_event_count", "connector_available", "connector_error_count"],
        "truth_rule": "登记、发现或候选不等于 connected；只有授权握手和读回执才能升级连接状态。",
        "external_action": false,
        "owner_gate": false
      },
      {
        "id": "blocked_external_action",
        "event_types": ["external_action_blocked"],
        "action_scope": "external_action_gate",
        "target_object_type": "blocked_action",
        "metric_ids": ["action_event_count", "action_blocked_count", "blocked_external_action_count"],
        "truth_rule": "记录被门禁拦截的外部动作；不得生成已执行或成功状态。",
        "external_action": false,
        "owner_gate": true
      }
    ],
    "external_actions": 0
  },
  "required_metric_metadata": [
    "metric_id",
    "family_id",
    "unit",
    "default_grain",
    "default_dimensions",
    "source_record_types",
    "truth_level",
    "nullable_reason",
    "owner_gate",
    "aggregation_rule"
  ],
  "metric_metadata_policy": {
    "one_row_per_registered_metric": true,
    "direct_primary_metric_truth_level": "canonical_with_lineage",
    "family_derived_metric_truth_level": "derived_with_formula_and_lineage",
    "platform_native_scale_must_be_preserved": true,
    "unknown_unit_or_formula_must_not_be_guessed": true,
    "rates_scores_ranks_and_forecasts_are_non_additive": true,
    "currency_aggregation_requires_identical_currency_scope": true
  },
  "source_freshness_contract": {
    "required_fields": ["source_ref", "observed_at", "freshness_status", "truth_level", "source_record_count"],
    "freshness_statuses": ["fresh", "delayed", "stale", "unknown"],
    "truth_levels": ["authorized_read", "manual_verified", "canonical_with_lineage", "derived_with_formula_and_lineage", "actual_platform_settlement", "unknown_until_evidenced"],
    "stale_data_never_becomes_zero": true,
    "missing_source_never_becomes_connected": true,
    "unknown_or_stale_must_be_visible_to_ai": true,
    "source_record_count_is_required_for_ai_answers": true
  },
  "commerce_scope_contract": {
    "required_route_dimensions": ["platform", "country_site", "store_mode", "ownership"],
    "store_modes": [
      {"id": "marketplace_seller", "label": "平台卖家店", "selectable": true, "executable": true},
      {"id": "local_store", "label": "本土店", "selectable": true, "executable": true},
      {"id": "cross_border", "label": "跨境 / 半托类", "selectable": true, "executable": true},
      {"id": "platform_co_ops", "label": "TeeLab 联名 / 代运营", "selectable": true, "executable": true},
      {"id": "teelab_owned", "label": "TeeLab 自营", "selectable": true, "executable": true},
      {"id": "official_full_managed", "label": "平台官方全托管", "selectable": false, "executable": false, "recognition_only": true}
    ],
    "unbound_store_status": "needs_platform_store",
    "unbound_store_excluded_from_operating_data": true,
    "registered_platform_without_store_is_not_a_store": true,
    "platform_group_is_not_an_executable_site": true,
    "direct_ship_contract": {
      "store_mode": "cross_border",
      "fulfillment_mode": "cross_border_direct_ship_from_china",
      "warehouse_country": "CN",
      "ship_from_country": "CN",
      "target_market_comes_from_country_site": true,
      "does_not_create_a_new_store_identity": true
    }
  },
  "platform_adaptation_contract": {
    "required_scope": ["platform", "country_site", "store_mode", "ownership", "fulfillment_mode", "account_or_store_id"],
    "metric_applicability_states": ["supported", "not_applicable", "unknown_until_evidenced", "source_missing"],
    "not_applicable_is_not_zero": true,
    "source_missing_is_not_zero": true,
    "platform_candidate_or_learning_asset_never_enters_operating_data": true,
    "platform_specific_formula_requires_dated_evidence": true,
    "cross_site_formula_reuse_requires_explicit_compatibility": true
  },
  "ai_analysis_contract": {
    "every_answer_must_reference": ["time_window", "source_record_count", "truth_level", "confidence", "missing_fields"],
    "allowed_outputs": ["diagnosis", "trend_analysis", "anomaly_detection", "opportunity_discovery", "risk_warning", "forecast", "what_to_check_next", "owner_review_proposal"],
    "blocked_outputs_without_approval": ["publish", "send_message", "change_price", "launch_ad", "spend_budget", "place_order", "refund", "ship", "oauth_connect", "scrape_private_area"],
    "minimum_context_for_recommendation": ["platform", "country_site", "store_or_account_scope", "date_range", "source_lineage", "data_gap_list"]
  },
  "dashboard_policy": {
    "top_dashboard_is_aggregate": true,
    "platform_sections_are_platform_rollups": true,
    "store_level_hidden_by_default": true,
    "drilldown_allowed_when_source_exists": true,
    "do_not_display_false_connected_running_synced": true,
    "zero_card_must_explain_missing_source": true
  }
}
