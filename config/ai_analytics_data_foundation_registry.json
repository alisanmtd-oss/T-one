  "analysis_layers": [
    {
      "id": "raw_ingestion",
      "label": "原始记录层",
      "purpose": "保留平台报表、ERP、账单、社媒后台、通信记录、人工录入和截图解析结果。",
      "allowed_status": ["raw_imported", "manual_verified", "authorized_read", "pending_owner_review"]
    },
    {
      "id": "canonical_fact",
      "label": "标准事实层",
      "purpose": "把不同平台字段映射到统一事实表，保留来源字段、来源文件、时间窗口和平台口径。",
      "allowed_status": ["canonical_with_lineage", "partially_mapped", "unknown_field_preserved"]
    },
    {
      "id": "rollup_feature",
      "label": "聚合与特征层",
      "purpose": "按平台、国家、店铺、账号、母体SKU、内容、直播、达人、活动、广告、客户和时间窗口聚合，供 AI 分析。",
      "allowed_status": ["computed_from_canonical", "derived_with_formula", "blocked_missing_source"]
    },
    {
      "id": "ai_analysis_case",
      "label": "AI 分析案例层",
      "purpose": "生成诊断、预测、归因、异常识别、机会识别和下一步建议。",
      "allowed_status": ["analysis_draft", "owner_review_required", "accepted_learning_memory", "rejected_or_superseded"]
    },
    {
      "id": "decision_receipt",
      "label": "决策与回执层",
      "purpose": "记录负责人批准、拒绝、修改、执行、结果回传和复盘，防止 AI 建议变成不可追溯动作。",
      "allowed_status": ["owner_approved", "owner_rejected", "executed_with_evidence", "result_reconciled"]
    }
  ],
