{
  "schema_version": 1,
  "updated_at": "2026-07-17",
  "purpose": "把电商、B2B 外贸、新媒体和公共运营拆成可安装、可授权、可审计的能力单元；一个任务只加载实际需要的能力。",
  "composition_rule": [
    "业务线 -> 岗位域 -> 工作阶段 -> 能力单元 -> 平台适配器 -> 真实店铺/账号执行身份",
    "平台适配器必须使用 platform + country_site + store_mode + ownership + store_id；销售计划、履约方式、联盟/直播/广告项目另设维度。",
    "同一用户可以有多个项目组；同一项目组可以有多个店铺任务；账号、浏览器环境、API 授权、库存和证据不得跨店串用。",
    "Skill 负责流程和知识，Agent 负责岗位目标与决策，Plugin/Connector 负责真实系统连接，Schedule 负责周期运行。"
  ],
  "human_input_policy": {
    "minimum_required_facts": [
      "产品或服务是什么",
      "SKU/变体或可识别的商品资料来源",
      "成本或成本数据来源",
      "售价/定价规则或利润底线",
      "图片/视频/素材或素材来源",
      "库存/产能/交期的真实数据来源",
      "需要执行的真实店铺、账号或客户主体"
    ],
    "ai_may_draft_or_infer": [
      "标题、五点、详情、关键词和多语言文案",
      "竞品分组、内容选题、脚本、分镜和提示词",
      "活动、广告、补货、客服和跟进建议",
      "线索评分、客户画像、报价草稿和复盘摘要"
    ],
    "must_not_infer_as_fact": [
      "品牌或知识产权授权",
      "公司、税务、银行和身份资料",
      "账号密码、MFA、验证码和支付凭据",
      "不存在的库存、成本、销量、利润、客户同意或平台授权",
      "平台官方全托管身份"
    ]
  },
