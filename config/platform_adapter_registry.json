{
  "schema_version": 2,
  "updated_at": "2026-07-17",
  "registry_kind": "platform_store_adapter_registry",
  "evidence_registry_ref": "config/platform_store_type_evidence_registry.json",
  "purpose": "平台、国家站点、店铺类型与真实执行身份的唯一分类入口；岗位能力通过 adapter_id 适配，不把平台名当成岗位。",
  "route_contract": {
    "route_key_format": "platform:country_site:commerce_mode",
    "required_scope_fields": ["tenant_id", "project_id", "store_binding_id", "platform", "country_site", "commerce_mode", "ownership", "execution_identity_id"],
    "separate_axes": ["authorization_product", "seller_plan", "seller_entity_type", "account_program", "category_scope", "category_authorization_level", "fulfillment_mode", "listing_offer_type", "operating_program", "ads_account_id", "warehouse_id", "settlement_account_id", "integration_capability_scope"],
    "route_statuses": ["needs_platform_store", "needs_authorization", "read_only", "draft_ready", "approval_required", "executable", "unsupported"],
    "execution_domains": ["listing", "orders", "inventory", "shipment", "settlement", "aftersales", "activities", "ads"],
    "invariants": [
      "Southeast Asia 只能作为区域分组，TikTok Shop、Shopee、Lazada 必须落到 SG/MY/TH/VN/PH/ID 具体站点。",
      "TeeLab 代运营 / 联名运营属于 ownership，不是 commerce_mode，也不等于 official_full_managed。",
      "official_full_managed 只作为不可选择的识别标签。",
      "同一平台的不同国家站点、店铺类型或真实店铺不得共享可执行凭据。",
      "FBA/FBM/WFS、自仓、第三方仓属于 fulfillment_mode，不属于 store_mode。",
      "Individual/Professional 等销售计划属于 seller_plan，不属于 store_mode。",
      "ACCU属于卖家主体/准入身份，不是独立经营模式。",
      "SIP、全球店、六合一、轻出海、CSP属于账号或店铺范围计划，不是国家站点。",
      "L3/L7以及服装、家居、定制、全类目属于类目权限或类目范围，不是经营模式。",
      "联盟、达人、直播、GMV Max、商品目录和广告属于 operating_program 或独立执行域，不冒充真实订单店铺。",
      "没有达到证据登记表门槛的值只能标记 pending_verification，不得自动映射或执行。"
    ]
  },
  "commerce_modes": [
    {"id": "owned_platform", "name": "自有平台", "selectable": true},
    {"id": "marketplace_seller", "name": "平台卖家店", "selectable": true},
    {"id": "platform_self_operated", "name": "平台自运营", "selectable": true},
    {"id": "local", "name": "本土店", "selectable": true, "aliases": ["local_store", "local_seller"]},
    {"id": "cross_border", "name": "跨境店", "selectable": true, "aliases": ["cross_border_seller"]},
    {"id": "semi_managed", "name": "半托管", "selectable": true},
    {"id": "independent_site", "name": "独立站", "selectable": true},
    {"id": "content_catalog", "name": "内容 / 商品目录", "selectable": true},
    {"id": "invite_partner", "name": "邀请制 / 合作伙伴店", "selectable": true},
    {"id": "official_full_managed", "name": "平台官方全托管（不接）", "selectable": false}
  ],
  "legacy_store_mode_aliases": {
    "self_store": {"axis": "ownership", "canonical": "self_owned"},
    "platform_co_ops": {"axis": "ownership", "canonical": "platform_co_ops"},
