{
  "last_checked_at": "2026-06-29",
  "source_review": {
    "checked_at": "2026-06-29",
    "default_boundary": "Official APIs, seller/admin backends, promotion tools, and ads accounts are separate authorization surfaces. Read-only sync can be automated after authorization; listing, discount, campaign, ad budget, refund, shipment, and authorization changes stay draft_then_confirmation or isolated_cloud_plugin_after_confirmation.",
    "official_sources": [
      {
        "channel_id": "tiktok_shop",
        "url": "https://partner.tiktokshop.com/docv2/",
        "finding": "Shop Open API, Seller Center promotion flows, Business Center, and ads account ownership must be treated as separate site/store identities."
      },
      {
        "channel_id": "shein",
        "url": "https://open.sheincorp.com/",
        "finding": "Marketplace/Open Platform routes must not mix local, cross-border, semi-managed, TeeLab co-ops, and official full-managed labels."
      },
      {
        "channel_id": "shopee",
        "url": "https://open.shopee.com/documents",
        "finding": "Open Platform is app/shop authorization based; campaign and voucher execution still needs country-site and store identity checks."
      },
      {
        "channel_id": "lazada",
        "url": "https://open.lazada.com/doc/doc.htm",
        "finding": "Open Platform coverage varies by country site and app permission; unresolved promotion actions remain backend drafts."
      },
      {
        "channel_id": "amazon",
        "url": "https://developer-docs.amazon.com/sp-api/",
        "finding": "Selling Partner API is separate from Amazon Ads API and Seller Central promotion workflows."
      },
      {
        "channel_id": "walmart",
        "url": "https://developer.walmart.com/us-marketplace/docs",
        "finding": "Marketplace item/order/inventory/report APIs and Walmart Connect advertising must be treated as separate seller and ad-account surfaces."
      },
      {
        "channel_id": "shopify",
        "url": "https://shopify.dev/docs/apps/build/discounts",
        "finding": "Discounts require app/admin scopes and per-store authorization; ads are outside Shopify Admin API."
      },
      {
        "channel_id": "woocommerce",
        "url": "https://developer.woocommerce.com/docs/apis/rest-api/",
        "finding": "REST API keys and webhooks are per WooCommerce store; ads and campaign tools are external."
      },
      {
        "channel_id": "meta_ads",
        "url": "https://developers.facebook.com/docs/marketing-apis/",
        "finding": "Meta advertising connection depends on Business/ad-account permissions and is not equivalent to store ERP authorization."
      },
      {
        "channel_id": "etsy",
        "url": "https://developers.etsy.com/documentation/",
        "finding": "Etsy Open API v3 is shop/app authorization based; listings, inventory, receipts/orders, payments and shop data require explicit scopes, while Etsy Ads and Offsite Ads stay separate seller/ads surfaces."
      },
      {
        "channel_id": "ebay",
        "url": "https://developer.ebay.com/api-docs/sell/static/sell-landing.html",
        "finding": "eBay Sell APIs split Inventory, Fulfillment, Account, Finances and Marketing; Promotions Manager, Promoted Listings and budget/ad changes are separate execution domains requiring confirmation. Campaign setup/launch cannot be treated as one-click automation because eBay removed setupQuickCampaign and launchCampaign from the campaign resource."
      }
    ],
    "implementation_policy": [
      "Treat APIs, seller backends, ads backends, Business/ad accounts as separate authorization surfaces.",
      "Map every store action to channelId:countryCode:storeModel before execution planning.",
      "Use /api/platform-activity/plan as the internal preflight before promotion, coupon, campaign, discount, or ad task packaging.",
      "Use isolated backend task identities when multi-store or multi-entity binding may create account association risk.",
      "Campaign signup, price change, coupon publish, refund, shipment, authorization, ad launch, and budget change require owner confirmation."
    ]
  },
