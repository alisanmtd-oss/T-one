      "structure": [
        "0-3秒同时展示全部实物",
        "3-9秒逐套切换颜色和穿搭",
        "9-14秒面料/洗水/尺码证据",
        "14-18秒组合价值与CTA"
      ]
    },
    {
      "id": "warehouse-proof-15",
