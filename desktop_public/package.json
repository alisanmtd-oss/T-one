{
  "name": "t-one-community-desktop",
  "version": "0.4.4",
  "private": true,
  "description": "Installable Windows shell for the public, offline T One community demo",
  "author": "T One Community",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.tone.community.desktop",
    "productName": "T One 中文社区版",
    "asar": true,
    "files": ["main.js", "package.json"],
    "extraResources": [
      {"from": "../demo/chat-first-workspace.html", "to": "public-demo/chat-first-workspace.html"},
      {"from": "../LICENSE", "to": "LICENSE.txt"}
    ],
    "win": {"target": ["nsis"]},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "T One 中文社区版",
      "artifactName": "T-One-Community-Setup-${version}.${ext}",
      "uninstallDisplayName": "T One 中文社区版"
    }
  }
}
