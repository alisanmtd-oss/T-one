{
  "name": "t-one-community-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Installable local-first T One community workspace for Windows",
  "author": "T One Community",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.tone.community.desktop",
    "productName": "T One 中文社区版",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "T One 中文社区版",
      "artifactName": "T-One-Community-Setup-${version}.${ext}",
      "uninstallDisplayName": "T One 中文社区版"
    }
  }
}
